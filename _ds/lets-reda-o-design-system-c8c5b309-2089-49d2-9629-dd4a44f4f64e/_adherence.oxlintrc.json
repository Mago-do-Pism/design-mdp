{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "ui_kits/site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Comfortaa|Archivo|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Comfortaa, Archivo, Caveat."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lime|yellow|lilac|purple|cream)$/]",
        "message": "<Badge> tone must be one of 'lime' | 'yellow' | 'lilac' | 'purple' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|block|disabled|iconLeft|iconRight|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, block, disabled, iconLeft, iconRight, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:surface|radius|bordered|padding|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: surface, radius, bordered, padding, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='surface'] > Literal[value!=/^(?:cream|sunken|lime|lilac)$/]",
        "message": "<Card> surface must be one of 'cream' | 'sunken' | 'lime' | 'lilac'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='radius'] > Literal[value!=/^(?:sm|md|lg|xl|2xl)$/]",
        "message": "<Card> radius must be one of 'sm' | 'md' | 'lg' | 'xl' | '2xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|block|children|key|ref|className|style|children)$/]",
        "message": "<Highlight> doesn't accept that prop. Declared props: tone, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Highlight'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:yellow|lime)$/]",
        "message": "<Highlight> tone must be one of 'yellow' | 'lime'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|multiline|rows|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, multiline, rows."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|assetBase|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: tone, width, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:pink|cream)$/]",
        "message": "<Logo> tone must be one of 'pink' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|period|note|badge|ctaLabel|onCta|bullets|key|ref|className|style|children)$/]",
        "message": "<PriceCard> doesn't accept that prop. Declared props: label, amount, period, note, badge, ctaLabel, onCta, bullets."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|score|photo|shapeTone|sparkleTone|assetBase|key|ref|className|style|children)$/]",
        "message": "<ResultCard> doesn't accept that prop. Declared props: name, score, photo, shapeTone, sparkleTone, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultCard'] > JSXAttribute[name.name='shapeTone'] > Literal[value!=/^(?:lime|yellow)$/]",
        "message": "<ResultCard> shapeTone must be one of 'lime' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultCard'] > JSXAttribute[name.name='sparkleTone'] > Literal[value!=/^(?:purple|yellow)$/]",
        "message": "<ResultCard> sparkleTone must be one of 'purple' | 'yellow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|tone|align|children|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: as, size, tone, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2|h3|h4)$/]",
        "message": "<SectionTitle> as must be one of 'h1' | 'h2' | 'h3' | 'h4'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|xl)$/]",
        "message": "<SectionTitle> size must be one of 'sm' | 'md' | 'lg' | 'xl'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lilac|deep|cream)$/]",
        "message": "<SectionTitle> tone must be one of 'lilac' | 'deep' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<SectionTitle> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkle'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|assetBase|key|ref|className|style|children)$/]",
        "message": "<Sparkle> doesn't accept that prop. Declared props: tone, size, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sparkle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:purple|yellow|yellow-pair)$/]",
        "message": "<Sparkle> tone must be one of 'purple' | 'yellow' | 'yellow-pair'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|handle|time|children|key|ref|className|style|children)$/]",
        "message": "<TestimonialBubble> doesn't accept that prop. Declared props: variant, handle, time, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='TestimonialBubble'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:message|comment)$/]",
        "message": "<TestimonialBubble> variant must be one of 'message' | 'comment'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|width|assetBase|key|ref|className|style|children)$/]",
        "message": "<WaveShape> doesn't accept that prop. Declared props: shape, width, assetBase."
      },
      {
        "selector": "JSXOpeningElement[name.name='WaveShape'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:band|upper|blob-top-left|blob-bottom-left|blob-bottom-right)$/]",
        "message": "<WaveShape> shape must be one of 'band' | 'upper' | 'blob-top-left' | 'blob-bottom-left' | 'blob-bottom-right'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
